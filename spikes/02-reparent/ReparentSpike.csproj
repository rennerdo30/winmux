<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ReparentSpike</RootNamespace>
    <AssemblyName>ReparentSpike</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Spike code: P/Invoke everywhere, no analyzers shouting about it. -->
    <NoWarn>CA1416</NoWarn>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>
  <!--
    Deliberately NO ApplicationManifest. A manifest-declared DPI awareness cannot be overridden
    at runtime, which silently defeated the DPI guinea pig (SetProcessDpiAwarenessContext returned
    false and every role still reported PerMonitor). The host sets PerMonitorV2 in code instead.
  -->
</Project>
