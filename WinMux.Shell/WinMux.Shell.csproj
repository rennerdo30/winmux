<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WinMux.Shell</RootNamespace>
    <AssemblyName>WinMux</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\assets\winmux.ico</ApplicationIcon>
    <NoWarn>CA1416</NoWarn>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <!--
      Remote file-browser filesystems. Both MIT, both long-established with public repositories:
      SSH.NET has ~336M downloads across four maintainers, FluentFTP ~59M. Named here rather than
      taken for granted because ADR 0018 is about the cost of the opposite case.
    -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="FluentFTP" Version="54.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinMux.Core\WinMux.Core.csproj" />
    <ProjectReference Include="..\WinMux.Panes\WinMux.Panes.csproj" />
    <ProjectReference Include="..\WinMux.Platform.Win32\WinMux.Platform.Win32.csproj" />
    <ProjectReference Include="..\WinMux.Pty\WinMux.Pty.csproj" />
    <ProjectReference Include="..\WinMux.Terminal\WinMux.Terminal.csproj" />
    <ProjectReference Include="..\WinMux.PaneHost\WinMux.PaneHost.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\WinMux.Connections\WinMux.Connections.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The window icon. The same file the executable carries, so they cannot disagree. -->
    <AvaloniaResource Include="..\assets\winmux.ico" Link="Assets/winmux.ico" />
    <!-- The .ico is what a Window wants; the title bar draws an Image, which wants a bitmap. -->
    <AvaloniaResource Include="..\assets\winmux-256.png" Link="Assets/winmux-256.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Cwd\Profiles\winmux.ps1" />
    <EmbeddedResource Include="Cwd\Profiles\winmux.cmd" />
    <EmbeddedResource Include="Cwd\Profiles\winmux.sh" />
    <None Include="..\WinMux.Platform.Win32\ForeignApps\foreign-app-quirks.json" Link="foreign-app-quirks.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Ask PaneHost where it actually built instead of guessing. The guess used to be
       bin\$(Configuration)\, but PaneHost is x64-only and so builds to bin\x64\$(Configuration)\:
       the copy found nothing, and on this machine quietly shipped a stale artifact left behind in
       the old path. A missing PaneHost.exe only surfaces much later, as a foreign-app pane that
       refuses to start, so this fails the build instead (CLAUDE.md section 8: no silent failure). -->
  <Target Name="ResolvePaneHostOutput">
    <MSBuild Projects="..\WinMux.PaneHost\WinMux.PaneHost.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);Platform=$(Platform)">
      <Output TaskParameter="TargetOutputs" ItemName="PaneHostTarget" />
    </MSBuild>
    <ItemGroup>
      <PaneHostOutput Include="%(PaneHostTarget.RootDir)%(PaneHostTarget.Directory)WinMux.PaneHost.*" />
    </ItemGroup>
    <Error Condition="'@(PaneHostOutput)' == ''" Text="WinMux.PaneHost produced no output to copy beside WinMux.exe. Foreign-app panes cannot start without it." />
  </Target>

  <Target Name="CopyPaneHost" AfterTargets="Build" DependsOnTargets="ResolvePaneHostOutput">
    <Copy SourceFiles="@(PaneHostOutput)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Publish needs its own copy: CopyPaneHost targets $(OutDir), and a published dist\ that is
       missing PaneHost.exe looks perfectly fine until the first foreign-app pane refuses to start. -->
  <Target Name="CopyPaneHostOnPublish" AfterTargets="Publish" DependsOnTargets="ResolvePaneHostOutput">
    <Copy SourceFiles="@(PaneHostOutput)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
