<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <!--
      Dynamic skip. xunit 2.x has no Assert.Skip (that is v3), and a test that silently passes when
      its server is absent would be a green tick proving nothing. Used only by RemoteLiveTests.
    -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinMux.Panes\WinMux.Panes.csproj" />
    <ProjectReference Include="..\WinMux.Platform.Win32\WinMux.Platform.Win32.csproj" />
    <ProjectReference Include="..\WinMux.Shell\WinMux.Shell.csproj" />
  </ItemGroup>

</Project>
