<Project>

  <!--
    Product identity, in one place, for every project in the solution.

    Before this there was no version anywhere: the built WinMux.exe reported 1.0.0.0 because that
    is what MSBuild invents when nobody says otherwise, and a published folder could not be told
    apart from any other. A release people can name is the difference between "a folder on my
    machine" and something shippable.

    0.x on purpose. CLAUDE.md still lists open decisions that belong before v1 — the
    Terminal.Emulation supply-chain call among them — and a 1.0 is a promise about compatibility
    that this project has not earned yet.
  -->
  <!--
    The version comes from the git tag, not from this file.

    It was written here by hand, which meant every release was two facts that had to agree: a
    number in source control and a tag next to it. They agreed by discipline, and discipline is
    the thing that fails at 2 a.m. MinVer reads the nearest `v*` tag and derives the rest, so
    `v0.7.9` *is* 0.7.9 and there is nothing to forget to bump.

    A commit that is not tagged gets the next patch with a prerelease suffix and the height, e.g.
    `0.7.9-alpha.0.3`. That is deliberate: a build from an untagged commit is not a release and
    should not claim to be one, and the updater already treats prereleases as a separate channel.

    Requires the tags to be present, so every CI checkout fetches them (`fetch-depth: 0`). A
    shallow clone silently produces 0.0.0-alpha.0, which is the one way this can go wrong quietly.
  -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <Product>WinMux</Product>
    <Company>WinMux</Company>
    <Authors>WinMux contributors</Authors>
    <Copyright>Copyright (c) 2026 rennerdo30 and WinMux contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/rennerdo30/winmux</RepositoryUrl>
  </PropertyGroup>

  <!--
    Lock the dependency graph, with hashes.

    WinMux depends on Terminal.Emulation, a package whose declared source repository does not
    resolve and whose whole history is five weeks old (ADR 0018). The supply-chain decision that
    situation demands is the user's, but recording exactly which bytes a build used does not need
    a decision and closes the worst version of the risk: a package replaced under the same version
    number, restored silently, and shipped.

    A restore that no longer matches packages.lock.json now fails instead of quietly resolving
    something else. When a dependency is deliberately changed, the lock file changes with it in the
    same commit — that is the point, not an inconvenience.
  -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build-time only: it sets the version properties and ships nothing. -->
    <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

</Project>
