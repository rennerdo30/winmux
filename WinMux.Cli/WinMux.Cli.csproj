<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ApplicationIcon>..\assets\winmux.ico</ApplicationIcon>
    <OutputType>Exe</OutputType>
    <!-- net10.0, not net10.0-windows: the CLI only touches WinMux.Core, so it stays portable too. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>wmux</AssemblyName>
    <RootNamespace>WinMux.Cli</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinMux.Core\WinMux.Core.csproj" />
  </ItemGroup>

</Project>
